# =====================================================================
# SharkHire backend configuration. Copy to `.env` (git-ignored) and fill in.
# NEVER commit real values. NEVER ship SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, JSEARCH_API_KEY or DATABASE_URL to the Flutter app.
# =====================================================================

# ---- Application ----
APP_NAME=SharkHire API
APP_ENV=development              # development | testing | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # true in production (structured logs)
# Random string >= 32 chars; signs local download links. REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Comma-separated WEB origins only. Native Android/iOS apps do not need CORS. No "*" in production.
CORS_ORIGINS=
ENABLE_DOCS=true                 # set false to hide /docs, /redoc, /openapi.json
MAX_REQUEST_BODY_BYTES=12582912
TRUST_PROXY_HEADERS=false        # true only behind a trusted reverse proxy / load balancer
PUBLIC_BASE_URL=http://localhost:8000

# ---- Database (Supabase PostgreSQL) ----
# Supabase dashboard > Connect. MUST start with postgresql:// (startup fails otherwise).
# Recommended: SESSION POOLER (IPv4):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The direct host db.<ref>.supabase.co is IPv6-only and fails on IPv4-only networks/hosts.
# Transaction pooler (port 6543): same as session pooler with port 6543 AND DB_USE_PGBOUNCER=true
DATABASE_URL=
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# ---- Supabase Auth ----
SUPABASE_URL=                    # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=               # public anon / publishable key (server uses it to call Auth)
# Server-side only: Supabase Storage + admin ban/unban. Leave empty if not needed.
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification. Asymmetric signing keys (recommended) are fetched from the JWKS URL.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWKS_URL=               # default: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=             # default: {SUPABASE_URL}/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy projects only (HS256 shared secret). HS256 is accepted ONLY if "HS256" is also listed in
# SUPABASE_JWT_ALGORITHMS. Leave EMPTY for projects that sign with ES256/RS256 (check the JWKS URL).
SUPABASE_JWT_SECRET=
JWKS_CACHE_TTL_SECONDS=600
# Deep links used in auth emails (must also be allowed in Supabase > Auth > URL Configuration)
AUTH_EMAIL_REDIRECT_URL=         # e.g. sharkhire://auth/callback
# REQUIRED for forgot-password: sent as redirect_to on every recovery e-mail. No quotes around the value.
# If empty, POST /api/v1/auth/forgot-password returns 503 password_reset_not_configured (never localhost).
# Check with GET /api/v1/health/auth after deploying.
AUTH_PASSWORD_RESET_REDIRECT_URL=sharkhire://auth/reset-password
PASSWORD_MIN_LENGTH=8
# Signup verification e-mail policy: 1 initial + N resends per cycle (persisted in PostgreSQL)
EMAIL_VERIFICATION_MAX_RESENDS=2
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_CYCLE_HOURS=24 # 0 = the limit never resets until the e-mail is verified

# ---- App access: 3-day app trial + RevenueCat monthly subscription ----
# See docs/subscription_backend.md. Missing values fail closed (no access is ever granted).
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
SUBSCRIPTION_EXEMPT_ROLES=admin
# RevenueCat dashboard -> Project settings -> API keys -> secret key (sk_...). Server only.
REVENUECAT_SECRET_API_KEY=
# Any long random string; paste the SAME value into RevenueCat -> Integrations -> Webhooks -> Authorization header.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_ENTITLEMENT_ID=app_access
REVENUECAT_OFFERING_ID=default
# Comma-separated store product ids per plan (Play may use "subscription_id:base_plan_id").
REVENUECAT_PRODUCT_INTERNATIONAL=
REVENUECAT_PRODUCT_PAKISTAN=
# Accept SANDBOX purchases. Leave empty = allowed everywhere except APP_ENV=production.
REVENUECAT_ALLOW_SANDBOX=
REVENUECAT_TIMEOUT_SECONDS=10
REVENUECAT_MAX_RETRIES=2
REVENUECAT_RETRY_BACKOFF_SECONDS=0.5

# ---- File storage ----
STORAGE_BACKEND=local            # local (development only) | supabase (production)
LOCAL_STORAGE_DIR=storage
# With STORAGE_BACKEND=supabase, SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (secret key, sb_secret_...) are REQUIRED
# on the server or CV uploads fail with 503 storage_not_configured. Verify: python scripts/setup_storage.py
# or GET /api/v1/health/storage on the running server.
SUPABASE_STORAGE_CV_BUCKET=cvs   # must be a PRIVATE bucket (python scripts/setup_storage.py --create)
SUPABASE_STORAGE_MEDIA_BUCKET=media  # PRIVATE bucket (photos, logos served via signed URLs)
SIGNED_URL_TTL_SECONDS=300
CV_MAX_FILE_SIZE_MB=5
IMAGE_MAX_FILE_SIZE_MB=2
CV_MAX_FILES_PER_USER=10
CV_MAX_PDF_PAGES=30

# ---- JSearch (RapidAPI) ----
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com
JSEARCH_SEARCH_PATH=/search-v2   # /search for the legacy page-based endpoint
JSEARCH_DETAILS_PATH=/job-details
JSEARCH_TIMEOUT_SECONDS=15
JSEARCH_MAX_RETRIES=2
JSEARCH_CACHE_TTL_SECONDS=3600
JSEARCH_DETAILS_REFRESH_SECONDS=86400
JSEARCH_MAX_NUM_PAGES=3
JSEARCH_GLOBAL_CALLS_PER_MINUTE=30   # per process; short-burst protection
# Plan quota guard: stop calling when RapidAPI reports <= this many requests left in the billing
# period (x-ratelimit-requests-remaining). The current plan allows 200 requests/month.
JSEARCH_QUOTA_RESERVE=5
JSEARCH_QUOTA_WARN_BELOW=25
JSEARCH_DEFAULT_COUNTRY=          # empty = do not force a country

# ---- Techmap (RapidAPI "Daily International Job Postings") - second job provider ----
# Searches query JSearch and Techmap together. Leave the key empty to use JSearch only.
# Every Techmap request counts against the plan quota; requests above it are BILLED as overage.
TECHMAP_ENABLED=true
TECHMAP_API_KEY=
TECHMAP_API_HOST=daily-international-job-postings.p.rapidapi.com
TECHMAP_CACHE_TTL_SECONDS=21600   # 6 h: repeated searches reuse cached Techmap results
TECHMAP_MAX_AGE_DAYS=30           # posting window when date_posted=all
TECHMAP_CALLS_PER_MINUTE=10
TECHMAP_QUOTA_RESERVE=10          # stop calling when <= this many requests remain (prevents overage)

# ---- Rate limits (per client, per process) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_PER_HOUR=3
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_RECOMMENDATION_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_REPORT_PER_HOUR=20

# ---- Recommendation weights (any non-negative numbers; renormalised) ----
REC_WEIGHT_REQUIRED_SKILLS=40
REC_WEIGHT_PREFERRED_SKILLS=15
REC_WEIGHT_EXPERIENCE=20
REC_WEIGHT_TITLE=10
REC_WEIGHT_LOCATION=10
REC_WEIGHT_EMPLOYMENT=5
REC_MAX_CANDIDATE_JOBS=500
REC_JOB_MAX_AGE_DAYS=45
REC_MIN_SCORE=20

# ---- Employer / moderation ----
JOB_MODERATION_ENABLED=true

# ---- Container (Docker only) ----
PORT=8000
WEB_CONCURRENCY=2

# ---- Advanced (defaults are fine) ----
APP_VERSION=1.0.0
DB_ECHO=false
AUTH_HTTP_TIMEOUT_SECONDS=10
JWT_LEEWAY_SECONDS=10
JSEARCH_CONNECT_TIMEOUT_SECONDS=5
JSEARCH_BACKOFF_BASE_SECONDS=0.5
JSEARCH_MAX_RETRY_AFTER_SECONDS=10
REC_HISTORY_LIMIT=200
